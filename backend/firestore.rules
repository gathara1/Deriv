rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Client-side access is strictly read-only for authenticated owners.
    // All execution-related writes (trades, signals, risk_state, deriv_link)
    // are written exclusively by the Python backend via Firebase Admin SDK.
    match /users/{uid}/{document=**} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}
